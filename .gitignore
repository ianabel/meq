# Build trees. The build is out-of-source -- `cmake -B build` and friends -- so
# an in-source CMakeCache.txt is a mistake worth seeing rather than ignoring.
/build/
/build-*/
CMakeUserPresets.json

# Reference papers. refs/Refs.md is the tracked index -- it says what each paper
# is and where to fetch it from -- but the PDFs themselves are publisher
# material and several MB each, so they stay out of the repository.
refs/*.pdf

# WSL writes an alternate-data-stream sidecar next to anything downloaded through
# Windows, recording the download zone. They arrive alongside the PDFs and are
# not matched by the rule above, since the name is "X.pdf:Zone.Identifier".
*:Zone.Identifier

# Editor and tooling droppings. compile_commands.json is generated by the build
# (CMAKE_EXPORT_COMPILE_COMMANDS) and .cache/ is clangd's index of it.
compile_commands.json
.cache/
.clangd
.vscode/
.idea/
*.swp
*.swo
*~
tags

# LaTeX. docs/manual/ is the pre-Sphinx manual, built by its own Makefile from
# the .tex sources; everything latex and bibtex leave behind is regenerated,
# including the PDF. These patterns moved from docs/ to docs/manual/ when the
# Sphinx tree took over docs/ -- a pattern left at docs/*.aux would have matched
# nothing, and the by-products would have shown up as untracked.
docs/manual/*.aux
docs/manual/*.bbl
docs/manual/*.blg
docs/manual/*.fdb_latexmk
docs/manual/*.fls
docs/manual/*.idx
docs/manual/*.ind
docs/manual/*.log
docs/manual/*.nav
docs/manual/*.out
docs/manual/*.pdf
docs/manual/*.snm
docs/manual/*.synctex.gz
docs/manual/*.toc

# Sphinx. docs/ is the Read the Docs source tree; _build/ is entirely generated,
# and doctrees/ is Sphinx's incremental cache.
docs/_build/
docs/doctrees/

# MFEM run output. A solve writes its mesh and its solution as a .mesh/.gf pair,
# and VisIt/ParaView dumps as .vtk/.vtu. Note that the sample data under
# attic/free-boundary/vacuum-testing/ is tracked and stays tracked -- these
# patterns only ever affect files git does not already know about, but a new
# file that is meant to be committed there will need `git add -f`.
*.mesh
*.gf
*.vtk
*.vtu
*.pvtu
# ParaViewDataCollection writes a DIRECTORY named after the run, holding a .pvd
# index and Cycle000000/ of pieces. The pieces are covered above; the .pvd was
# not, and without it git showed the whole directory as untracked -- a directory
# whose every entry is ignored is itself hidden, so this one line is what keeps
# a driver test from leaving `?? soloviev-nstx/` behind. The names come from
# user configs, so there is nothing more specific to match on.
*.pvd
# The driver's (R, Z) grid file. Same reasoning: run output, not source.
*.nc
visit_dump*/
ParaView/

# Build products from the compiler and the profilers.
*.o
*.d
*.a
*.so
gmon.out
*.gcda
*.gcno
*.gcov

# Scratch directories at the root. Anchored with a leading slash deliberately:
# an unanchored pattern matches at every depth, so `/runs/` here cannot quietly
# swallow some future tests/runs/ as well. `git check-ignore -v <path>` names
# the line responsible when something has gone missing.
/scratch/
/runs/
/tmp/

__pycache__/
.venv/

# The `docs` target's virtualenv, holding Sphinx and its theme. It is a
# separate environment because docs/requirements.txt pins Sphinx below 8 for
# the theme, and nothing else should be held to a docs constraint.
.venv-docs/
